# ---------------------------------------------------------------------------
# ViperByte environment variables. Copy to `.env` and fill in values.
# Never commit real credentials.
# ---------------------------------------------------------------------------

# PostgreSQL connection string
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/launchly"

# Auth.js — generate with: openssl rand -base64 32
AUTH_SECRET=""
# Public URL of the app. AUTH_URL is optional locally (derived from the request);
# set both to your HTTPS domain in production.
AUTH_URL="http://localhost:3000"
APP_URL="http://localhost:3000"

# Google sign-in (optional). Create an OAuth client at https://console.cloud.google.com/apis/credentials
# Authorized redirect URI: <APP_URL>/api/auth/callback/google
AUTH_GOOGLE_ID=""
AUTH_GOOGLE_SECRET=""

# Comma-separated emails that become studio admins on their first *Google-verified* sign-in.
ADMIN_EMAILS=""

# AI provider for optional internal project briefs: "none" | "anthropic"
# The app works fully with "none".
AI_PROVIDER="none"
AI_API_KEY=""
# Optional model override for the selected provider
AI_MODEL=""

# File storage: "local" (filesystem) or "vercel-blob" (private Vercel Blob; needs BLOB_READ_WRITE_TOKEN)
STORAGE_PROVIDER="local"
BLOB_READ_WRITE_TOKEN=""
STORAGE_LOCAL_DIR="./storage/uploads"
# Reserved for S3-compatible providers
STORAGE_BUCKET=""
STORAGE_ENDPOINT=""

# Email: "console" logs emails (development) or "resend" (needs RESEND_API_KEY).
# EMAIL_FROM must use a domain verified in Resend, or Resend's test sender
# (onboarding@resend.dev, which only delivers to your Resend account's email).
EMAIL_PROVIDER="console"
RESEND_API_KEY=""
EMAIL_FROM="ViperByte <onboarding@resend.dev>"
# Replies to any app email go here.
EMAIL_REPLY_TO=""
# Studio-facing emails (new projects, messages, leads, approvals) go to this inbox.
STUDIO_NOTIFY_EMAIL=""

# Password for seeded development accounts (admin@example.com, client@example.com).
# Seeding refuses to run when NODE_ENV=production.
SEED_DEV_PASSWORD="change-me-dev-only"
